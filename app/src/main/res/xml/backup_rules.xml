<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        P0 Google Play : aucune donnée locale Lexica n'est exportée via Auto Backup.
        On garde une posture conservative tant que la stratégie de restauration n'a pas
        été validée pour Room, préférences utilisateur et état de session.
    -->
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="files" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>