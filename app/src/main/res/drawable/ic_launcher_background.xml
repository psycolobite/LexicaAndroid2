<?xml version="1.0" encoding="utf-8"?>
<!--
    Background Lexica v4
    Fond dégradé "Océan du Savoir"
    Bleu royal (#1565C0) → Sarcelle profonde (#006064), diagonal.
    Halo central subtil pour ancrer le regard.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dégradé diagonal principal -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1565C0"
                android:endColor="#FF006064" />
        </aapt:attr>
    </path>

    <!-- Halo central (profondeur) -->
    <path android:pathData="M54,54 m-45,0 a45,45 0 1,0 90,0 a45,45 0 1,0 -90,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="45"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
