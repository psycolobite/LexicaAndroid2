<?xml version="1.0" encoding="utf-8"?>
<!--
    Background Lexica - Option C (Flashcards & Deep Blue)
    Dégradé élégant Bleu Nuit (#0D1B2A) → Bleu Royal (#1565C0)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fond dégradé principal -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="10"
                android:endX="90"
                android:endY="98"
                android:startColor="#FF0F172A"
                android:endColor="#FF1E40AF" />
        </aapt:attr>
    </path>

    <!-- Halo lumineux central subtil -->
    <path android:pathData="M54,54 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="44"
                android:startColor="#3360A5FA"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

</vector>
